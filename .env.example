# ── teams-agent-bridge configuration ─────────────────────────────────────
# Copy to .env (npm run setup does this). Never commit .env — it holds secrets.

# Which app on your phone gets the questions: telegram | teams
# (auto: telegram if TELEGRAM_BOT_TOKEN is set, otherwise teams)
BRIDGE_CHANNEL=

# ── Telegram (free; `npm run telegram:setup` fills these in) ──
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Microsoft Teams via Power Automate (needs Premium for the ask flow) ──
TEAMS_ASK_FLOW_URL=
TEAMS_NOTIFY_WEBHOOK_URL=

# ── Behaviour ──
# How long the agent waits for your answer (minutes).
BRIDGE_TIMEOUT_MINUTES=30
# Name shown in messages (defaults to the PC hostname).
BRIDGE_MACHINE_NAME=

# Hooks (enforced approvals)
BRIDGE_HOOK_ENABLED=true
# true  = hooks only act after `npm run away` (recommended)
# false = hooks always send approvals to your phone
BRIDGE_REQUIRE_AWAY_FLAG=true
# Regex of tool names that need your approval (empty = terminal-like tools).
# See the real tool names with `npm run log`. Examples:
#   terminal   |   terminal|create_file|replace_string   |   .*  (every tool)
BRIDGE_GATE_TOOLS=
# If you don't answer in time: deny | allow
BRIDGE_ON_TIMEOUT=deny
# When the agent finishes: ask (Done / send new instructions) | notify | off
BRIDGE_STOP_HOOK=ask

# ── Company network ──
# If the PC needs a proxy to reach the internet, set it here (or in Windows env vars):
# HTTPS_PROXY=http://proxy.company.com:8080
# NO_PROXY=localhost,127.0.0.1
