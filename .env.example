# ── teams-agent-bridge configuration ─────────────────────────────────────
# Copy to .env (npm run setup does this) and fill in. Never commit .env:
# the flow URLs contain a secret signature — anyone with them can post to you.

# REQUIRED. HTTP trigger URL of the "Agent – ask me" Power Automate flow
# (docs/SETUP-POWER-AUTOMATE.md, Flow A).
TEAMS_ASK_FLOW_URL=

# OPTIONAL. Teams Workflows webhook for one-way notifications (Flow B).
TEAMS_NOTIFY_WEBHOOK_URL=

# How long the agent waits for your answer before giving up (minutes).
TEAMS_TIMEOUT_MINUTES=30
# Polling interval while waiting (seconds).
TEAMS_POLL_SECONDS=5
# Name shown on the cards (defaults to the PC hostname).
TEAMS_MACHINE_NAME=

# ── Hook (enforced approvals) ──
TEAMS_HOOK_ENABLED=true
# true  = hooks only act after `npm run away` (recommended)
# false = hooks always send approvals to Teams
TEAMS_REQUIRE_AWAY_FLAG=true
# Regex of tool names that need your approval. Discover names with the agent
# debug logs. Examples:  run_in_terminal   |   run_in_terminal|create_file|replace_string   |   .*
TEAMS_GATE_TOOLS=run_in_terminal
# What to do if you don't answer in time: deny | allow
TEAMS_ON_TIMEOUT=deny
# When the agent finishes: ask (Done / Continue + new instructions) | notify | off
TEAMS_STOP_HOOK=ask
